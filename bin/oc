#!/usr/bin/env bash
# Launch opencode against the remote Ollama host behind Cloudflare Access.
# Needs CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET (Access service token) in the environment.
set -euo pipefail
HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="${OLLAMA_APP_URL:-https://ollama.hypnodroid.com}"
MODEL="${OLLAMA_MODEL:-qwen3.8:27b}"

: "${CF_ACCESS_CLIENT_ID:?Set CF_ACCESS_CLIENT_ID (see README)}"
: "${CF_ACCESS_CLIENT_SECRET:?Set CF_ACCESS_CLIENT_SECRET (see README)}"

# A cold 27B load can outlast Cloudflare's 100s limit (502/524); the load still
# finishes server-side, so retry a tiny request until the model is resident.
for i in 1 2 3 4 5 6; do
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 130 \
    -H "CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID" -H "CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET" \
    "$APP/api/generate" -d "{\"model\":\"$MODEL\",\"keep_alive\":\"30m\"}" || true)"
  [ "$code" = "200" ] && break
  echo "Warming $MODEL (attempt $i, HTTP $code)..." >&2
done

export OPENCODE_HARNESS_DIR="$HARNESS_DIR"
export OPENCODE_CONFIG="$HARNESS_DIR/config/opencode.json"
exec opencode "$@"
