{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b",
  "small_model": "ollama/qwen3.8:27b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (remote)",
      "options": {
        "baseURL": "https://ollama.hypnodroid.com/v1",
        "headers": {
          "CF-Access-Client-Id": "{env:CF_ACCESS_CLIENT_ID}",
          "CF-Access-Client-Secret": "{env:CF_ACCESS_CLIENT_SECRET}"
        }
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "hello-fastmcp": {
      "type": "local",
      "command": ["uv", "run", "--with", "fastmcp", "fastmcp", "run", "{env:OPENCODE_HARNESS_DIR}/examples/hello_server.py"],
      "enabled": false
    }
  }
}
